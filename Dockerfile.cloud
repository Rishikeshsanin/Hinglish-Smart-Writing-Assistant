# Supported public-web Python 3.12 runtime using the ORIGINAL official IndicXlit
# checkpoint, only after external real-browser verification. Never use for BharatGen.
FROM python:3.12-slim-bookworm
ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    INDICWRITE_PY312_COMPAT=1 INDICWRITE_PRIVATE_BHARATGEN=0 \
    INDICWRITE_ENABLE_LANGUAGE_SERVICES=0 OMP_NUM_THREADS=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc g++ libgomp1 git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN python -m pip install 'pip==23.3.2' 'setuptools<70' wheel
RUN python -m pip install 'torch==2.6.0' --index-url https://download.pytorch.org/whl/cpu
COPY requirements-local.txt ./
RUN python -m pip install -r requirements-local.txt \
 && python -m pip install 'codemix-restore-shunyalabs==0.4.0' --no-deps
COPY app.py ./
COPY src/ ./src/
COPY scripts/smoke_indicxlit.py ./scripts/smoke_indicxlit.py
COPY .streamlit/config.toml ./.streamlit/config.toml
EXPOSE 8501
CMD ["sh","-c","python -m streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
